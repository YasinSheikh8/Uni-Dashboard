# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite for local dev — no setup required. In production point this at
# Postgres and scripts/prepare-db-provider.mjs rewrites the Prisma datasource
# during the build; there is no second schema file to keep in step.
DATABASE_URL="file:./dev.db"

# Unpooled connection string. REQUIRED whenever DATABASE_URL points at a pooled
# endpoint — a Neon host containing "-pooler", or Supabase on port 6543.
# PgBouncer cannot run DDL reliably, so schema pushes go direct while the app's
# runtime queries keep using the pooled url. Neon shows both strings on the
# project dashboard; they differ only by the "-pooler" suffix in the host.
DIRECT_URL=""

# ---------------------------------------------------------------------------
# Session signing
# ---------------------------------------------------------------------------
# Any long random string. Generate with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"

# ---------------------------------------------------------------------------
# Rate suppliers
# ---------------------------------------------------------------------------
# Every supplier is optional. Whichever keys are present get queried in
# parallel and their results compared; if none are set the app falls back to
# the built-in fixture supplier so it still runs end to end.

# LiteAPI — https://dashboard.liteapi.travel (instant free sandbox key)
LITEAPI_KEY=""
LITEAPI_BASE_URL="https://api.liteapi.travel/v3.0"

# Amadeus Self-Service — https://developers.amadeus.com (instant free key)
AMADEUS_CLIENT_ID=""
AMADEUS_CLIENT_SECRET=""
AMADEUS_BASE_URL="https://test.api.amadeus.com"

# Force the fixture supplier on even when real keys exist (useful for demos).
USE_FIXTURE_SUPPLIER="false"

# ---------------------------------------------------------------------------
# Price-reference scraping  (OFF by default — read this before switching it on)
# ---------------------------------------------------------------------------
# Scraped prices are REFERENCE ONLY. They appear in the comparison and can be
# deep-linked, but they can never be booked: there is no rate token behind a
# number lifted off a search page, and the booking engine rejects them.
#
# Before enabling, understand what you are turning on: scraping a booking
# site's search results is very likely against its terms of service however
# politely it is done, page markup changes without notice, and the prices are
# not transactable. robots.txt is fetched and honoured per target (fail-closed),
# requests to a host are serialized with a minimum gap, and results are cached —
# but none of that makes it permitted, only well-behaved.
SCRAPER_ENABLED="false"
# Comma-separated target ids. Built in: booking, hotels
SCRAPER_TARGETS=""
# Identify yourself honestly, with a contact URL that resolves.
SCRAPER_USER_AGENT="BKRBot/0.1 (+https://bkr.example/bot)"
# Floor between requests to one host, in ms. A site's own crawl-delay wins if larger.
SCRAPER_MIN_INTERVAL_MS="1500"
SCRAPER_CACHE_TTL_MS="900000"

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# In production set this to the deployed origin, e.g. https://bkr.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Shared secret for POST /api/cron/settle.
#
# On Vercel this is the name Vercel itself uses: set CRON_SECRET and Vercel
# automatically sends it as a Bearer token on every cron invocation, so the
# schedule in vercel.json authenticates with no extra wiring. The endpoint
# refuses to run when this is unset.
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# How long friends have to accept their share before the organizer's backstop
# authorization is captured for the shortfall. Card authorizations expire after
# about 7 days, so keep this comfortably under that.
SPLIT_SETTLEMENT_HOURS="72"

# ---------------------------------------------------------------------------
# Sign-in providers
# ---------------------------------------------------------------------------
# All optional. Email/password always works, and phone sign-in works without
# Twilio in development — the code is printed to the server log instead of sent.
# Configure a provider fully or not at all; a half-set provider shows a button
# that fails at the redirect, and the preflight warns about exactly that.

# Google — console.cloud.google.com → APIs & Services → Credentials →
# OAuth client ID (Web application).
# Authorised redirect URI: https://YOUR-DOMAIN/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Apple — developer.apple.com (requires a PAID Apple Developer account, $99/yr).
# Create a Services ID (this is APPLE_CLIENT_ID, not your app's bundle id) and a
# Sign in with Apple key, which downloads a .p8 file exactly once.
# Return URL: https://YOUR-DOMAIN/api/auth/callback/apple
# APPLE_PRIVATE_KEY is the .p8 contents; keep the BEGIN/END lines and replace
# real newlines with \n so it fits in a single environment variable.
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""

# Twilio — for delivering phone sign-in codes.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Auth.js signing key. Falls back to SESSION_SECRET when unset, so this is
# optional unless you want the two rotated independently.
AUTH_SECRET=""
