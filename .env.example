# ─── Yasin's Dashboard — server configuration ─────────────────────────────────────
# Copy to .env.local (local) or set in your host's environment settings.
# Everything here stays on the server. Never commit real values.

# Optional app lock. Leave empty for no password (anyone with the URL can open the app).
APP_PASSCODE=
# Random string, 32+ chars, used to sign the session cookie: `openssl rand -hex 32`
SESSION_SECRET=

# Moodle web-service token (Moodle → Preferences → Security keys →
# "Moodle mobile web service"). Leave empty to run in demo mode.
MOODLE_TOKEN=
# MOODLE_URL=https://moodle.warwick.ac.uk
# Seconds to cache Moodle responses in memory (default 300).
# MOODLE_CACHE_SECONDS=300
# Force sample data even if a token is set.
# DEMO_MODE=1

# Optional: your Tabula timetable calendar subscription link (an .ics URL).
# You can also paste it in Settings instead. Treat it like a password.
# TIMETABLE_ICS_URL=
# TIMETABLE_FEED_HOSTS=tabula.warwick.ac.uk,warwick.ac.uk,my.warwick.ac.uk

# Optional: AI study guides and assessment action plans (Claude API).
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Storage for your notes/checklists. Default: JSON file in ./.data (or DATA_DIR).
# On Vercel or other serverless hosts, use Upstash Redis / Vercel KV:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Rename the product without touching code.
# NEXT_PUBLIC_APP_NAME=Yasin's Dashboard
