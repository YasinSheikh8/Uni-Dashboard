// Hotelbook data model.
//
// Provider is SQLite so the app runs locally with zero setup. Nothing here uses
// SQLite-only features — swap the provider to "postgresql" and every model
// migrates as-is. JSON payloads are stored as String for the same reason.
//
// All money is stored in minor units (cents) as Int. Never floats.

generator client {
  provider      = "prisma-client-js"
  // "native" builds for the machine running `prisma generate`;
  // rhel-openssl-3.0.x is what Netlify/Vercel lambdas actually run on.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(cuid())

  /// Optional: someone who signs in with Apple's "hide my email" or with a
  /// phone number may never give us a real address.
  email         String?   @unique
  emailVerified DateTime?

  /// Optional: OAuth and phone users have no password at all.
  passwordHash String?

  /// E.164, e.g. +447700900123. Unique so a number maps to one account.
  phone         String?   @unique
  phoneVerified DateTime?

  name        String
  image       String?
  avatarColor String   @default("#1f6feb")
  createdAt   DateTime @default(now())

  // Stripe customer, created lazily the first time a card is saved.
  stripeCustomerId String? @unique

  /// Linked Google/Apple identities.
  accounts Account[]
  sessions Session[]

  profile        TravelerProfile?
  paymentMethods PaymentMethod[]

  organizedBookings Booking[]            @relation("BookingOrganizer")
  participations    BookingParticipant[]

  friendshipsInitiated Friendship[] @relation("FriendshipRequester")
  friendshipsReceived  Friendship[] @relation("FriendshipAddressee")
}

/// Everything needed to fire a booking without asking the user anything.
/// A complete profile is what makes one-tap booking possible.
model TravelerProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName   String
  lastName    String
  phone       String
  dateOfBirth DateTime?
  nationality String?

  /// Where the hotel sends the confirmation.
  ///
  /// Only needed when the ACCOUNT has no email — a phone sign-in, or Apple's
  /// "hide my email". Suppliers require a contact address on the reservation,
  /// so this is what makes those accounts bookable rather than blocked.
  contactEmail String?

  addressLine1   String?
  addressCity    String?
  addressZip     String?
  addressCountry String?

  updatedAt DateTime @updatedAt
}

model PaymentMethod {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  stripePaymentMethodId String   @unique
  brand                 String
  last4                 String
  expMonth              Int
  expYear               Int
  isDefault             Boolean  @default(false)
  createdAt             DateTime @default(now())

  @@index([userId])
}

model Friendship {
  id String @id @default(cuid())

  requesterId String
  requester   User   @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  addresseeId String
  addressee   User   @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  /// pending | accepted
  status    String   @default("pending")
  createdAt DateTime @default(now())

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
}

model Booking {
  id String @id @default(cuid())

  organizerId String
  organizer   User   @relation("BookingOrganizer", fields: [organizerId], references: [id])

  /// pending_payment | confirmed | settling | settled | cancelled | failed
  status String @default("pending_payment")

  // ---- What was booked -------------------------------------------------
  supplier           String // liteapi | amadeus | fixture
  supplierHotelId    String
  supplierRateId     String
  supplierBookingRef String?
  confirmationCode   String?

  hotelName     String
  hotelAddress  String
  hotelCity     String
  hotelCountry  String
  hotelImageUrl String?
  hotelRating   Float?
  roomName      String

  checkIn  DateTime
  checkOut DateTime
  nights   Int
  guests   Int
  rooms    Int      @default(1)

  // ---- Money (minor units) ---------------------------------------------
  currency    String
  totalAmount Int

  /// JSON snapshot of every supplier quote we saw for this hotel at search
  /// time, so we can show "we checked N suppliers, this was the cheapest".
  priceComparison String?

  /// Amount the cheapest rejected competing quote came in at, if any.
  savedAmount Int?

  // ---- Hybrid split settlement ----------------------------------------
  /// Organizer's backstop authorization covering all friends' shares. This is
  /// what guarantees the booking the instant it is made.
  backstopPaymentIntentId String?
  backstopAmount          Int     @default(0)
  /// none | authorized | captured | released | failed
  backstopStatus          String  @default("none")

  settlementDeadline DateTime?
  settledAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants BookingParticipant[]

  @@index([organizerId])
  @@index([status])
}

model BookingParticipant {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  /// Null until an invited-by-email friend signs up.
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  /// Null for participants who have no email at all — someone who signed in
  /// with a phone number, or with Apple's "hide my email". Such a participant
  /// is identified by userId instead. The unique constraint below still stops
  /// the same address being invited twice; Postgres does not treat NULLs as
  /// equal, so several email-less participants can coexist on one booking.
  email String?
  name  String?

  /// organizer | friend
  role String @default("friend")

  shareAmount Int

  /// pending | authorized | captured | declined | failed | covered_by_organizer
  status String @default("pending")

  stripePaymentIntentId String?
  respondedAt           DateTime?
  createdAt             DateTime  @default(now())

  @@unique([bookingId, email])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Auth.js
//
// Standard adapter models. Sessions use the JWT strategy (required for the
// credentials-based password and phone flows), so the Session table is mostly
// vestigial — it stays because the adapter interface expects it and because
// switching to database sessions later should not need a migration.
// ---------------------------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// One-time codes for phone sign-in.
///
/// The code is stored as a hash, never in plaintext — a leaked database should
/// not hand over live sign-in codes. `attempts` caps brute force against a
/// six-digit space, and rows are single-use: consumed on success, deleted on
/// expiry sweep.
model PhoneOtp {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
  @@index([expiresAt])
}
